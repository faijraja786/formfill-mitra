rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin registry is provisioned manually by the project owner
    // in Firebase Console. Clients may only read their own record.
    match /admins/{userId} {
      allow get: if request.auth != null
                 && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Default deny: add narrowly scoped rules only after the
    // data ownership and tenant model has been reviewed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}